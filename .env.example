# True Crew environment configuration.
#
# Leave these unset to run with the built-in LOCAL DEV auth provider (seeded users,
# see the login screen). Set them to switch the app to the production stack:
# Supabase Auth + Postgres. No other code changes are required.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret used to sign the local dev session cookie. Override in shared environments.
AUTH_DEV_SECRET=truecrew-dev-secret-change-me
