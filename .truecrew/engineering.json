  },
  "risk": {
    "level": "medium",
    "domains": [
      "privacy",
      "marketing-claims"
    ]
  },
  "quality": {
    "profile": "premium-experience",
    "guardrailCommand": "git diff --check",
    "verificationCommands": [
      "git diff --check"
    ]
  },
  "telemetry": {
    "mode": "required",
    "privacyRule": "Collect only the minimum first-party operational outcome metadata needed for governance and value measurement; never record secrets or sensitive customer content.",
    "outcomes": []
  },
  "ai": {
    "preflightRequired": true,
    "productionMutationRequiresExplicitApproval": true,
    "prohibitedActions": [
      "reveal-secrets",
      "weaken-security-gates",
      "modify-unrelated-work"
    ]
  },
  "exceptions": []
